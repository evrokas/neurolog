<div class="content">
    <h2>{{{t('Patients')}}}</h2>
    <form method="get" action="{{rel_url('/patients')}}" class="search-line">
        <input type="search" name="q" value="{{{$q}}}" class="wide-text" placeholder="{{{t('Name or P- ID')}}}" autocomplete="off">
        <button class="btn" type="submit">{{{t('Find')}}}</button>
    </form>
    <p class="muted small">{% if($q === ''): %}{{{t('The patients with the latest operations.')}}}{% else: %}{{{count($rows)}}} {{{t('found')}}}{% endif %}</p>
    <table class="list">
        <thead><tr><th>ID</th><th>{{{t('Name')}}}</th><th>{{{t('Born')}}}</th><th>{{{t('Operations')}}}</th><th>{{{t('Latest')}}}</th><th></th></tr></thead>
        <tbody>
        {% foreach($rows as $r): %}
            <tr>
                <td><a href="{{rel_url('/patients/' . $r['nl'])}}"><code>{{{$r['nl']}}}</code></a></td>
                <td>{{{$r['surname']}}} {{{$r['given_name'] ?? ''}}}</td>
                <td>{{{$r['birth_date'] ?? ''}}}</td>
                <td>{{{$r['n_ops']}}}</td>
                <td>{{{$r['last_op'] ?? ''}}}</td>
                <td>{% if($r['match_status'] === 'possible_duplicate'): %}<span class="badge badge-warning">{{{t('possible duplicate')}}}</span>{% endif %}</td>
            </tr>
        {% endforeach %}
        {% if(!$rows): %}<tr><td colspan="6" class="muted">{{{t('No patient found.')}}}</td></tr>{% endif %}
        </tbody>
    </table>
</div>
