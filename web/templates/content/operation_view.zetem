<div class="content op-view">
    <div class="page-head">
        <h2>{{{t('Operation')}}} <code>{{{$nl}}}</code></h2>
        <div>
            {% if($can_confirm): %}
            <form method="post" action="{{rel_url('/operations/' . $nl . '/confirm')}}" class="inline">{{ csrf_field() }}
                <button class="btn primary" type="submit">✓ {{{t('Confirm codes')}}} ({{{$suggested}}})</button></form>
            {% endif %}
            {% if($can_edit): %}<a class="btn" href="{{rel_url('/operations/' . $nl . '/edit')}}">{{{t('Edit')}}}</a>{% endif %}
        </div>
    </div>
    {% if($suggested): %}<div class="notice notice-warning">{{{$suggested}}} {{{t('coded rows are suggested: they count in statistics only after the primary surgeon confirms them.')}}}</div>{% endif %}

    <dl class="kv">
        <dt>{{{t('Patient')}}}</dt><dd>{{{$patient['surname'] ?? ''}}} {{{$patient['given_name'] ?? ''}}} · <code>{{{$patient['nl_id_display'] ?? ''}}}</code>{% if(!empty($patient['birth_date'])): %} · {{{t('born')}}} {{{$patient['birth_date']}}}{% endif %}</dd>
        <dt>{{{t('Date')}}}</dt><dd>{{{$op['op_date']}}}</dd>
        <dt>{{{t('Hospital')}}}</dt><dd>{{{$hosp[$op['hospital_ref']] ?? '—'}}}</dd>
        <dt>{{{t('Primary surgeon')}}}</dt><dd>{{{$names[$op['primary_surgeon_ref']] ?? '—'}}}</dd>
        <dt>{{{t('Assistants')}}}</dt><dd>{{{implode(', ', array_filter([$names[$op['assistant_1_ref']] ?? null, $names[$op['assistant_2_ref']] ?? null])) ?: '—'}}}</dd>
        <dt>{{{t('Anaesthetist')}}}</dt><dd>{{{$names[$op['anaesthetist_ref']] ?? '—'}}}</dd>
        <dt>{{{t('Urgency')}}} · {{{t('episode')}}}</dt><dd>{{{nl_show($lists, 'field.operation.indication_urgency', $op['indication_urgency'])}}} · {{{nl_show($lists, 'field.operation.reoperation', $op['reoperation'])}}}</dd>
        <dt>ASA · {{{t('anaesthesia')}}} · {{{t('position')}}}</dt><dd>{{{nl_show($lists, 'field.operation.asa_class', $op['asa_class'])}}} · {{{nl_show($lists, 'field.operation.anaesthesia', $op['anaesthesia'])}}} · {{{nl_show($lists, 'field.operation.position', $op['position'])}}}</dd>
        <dt>{{{t('Skin to skin')}}}</dt><dd>{{{$op['skin_incision_time'] ? substr($op['skin_incision_time'], 0, 5) : '—'}}} – {{{$op['skin_closure_time'] ? substr($op['skin_closure_time'], 0, 5) : '—'}}}</dd>
        <dt>{{{t('Blood loss')}}} · {{{t('transfusion')}}}</dt><dd>{{{$op['blood_loss_ml'] ?? '—'}}} mL · {{{$op['transfusion_units'] ?? '—'}}} u</dd>
        <dt>{{{t('Neuromonitoring')}}}</dt><dd>{{{nl_show($lists, 'field.operation.neuromonitoring', $op['neuromonitoring'])}}}</dd>
        <dt>{{{t('Construct')}}}</dt><dd>{{{str_replace('_', ' ', $op['construct'] ?? 'none')}}}</dd>
    </dl>

    <h3>{{{t('Diagnoses')}}}</h3>
    {% foreach($dx as $d): %}
    <div class="coded-row{% if($d['coding_status'] !== 'confirmed'): %} is-suggested{% endif %}">
        <span class="chip" data-family="diagnosis">{{{nl_label($lists, 'diagnosis', $d['diagnosis_code'])}}}</span>
        {% if($d['is_main']): %}<span class="badge badge-info">{{{t('main')}}}</span>{% endif %}
        {% if($d['levels_list']): %}<span class="chip chip-level">{{{implode(', ', json_decode($d['levels_list'], true))}}}</span>{% endif %}
        {% if($d['lesion_side']): %}<span class="muted">{{{nl_show($lists, 'procedure.side', $d['lesion_side'])}}}</span>{% endif %}
        {% if($d['qualifiers']): %}{% foreach(json_decode($d['qualifiers'], true) as $qn => $qv): %}<span class="muted small">{{{str_replace('_', ' ', $qn)}}}: {{{is_array($qv) ? implode('+', $qv) : $qv}}}</span> {% endforeach %}{% endif %}
        {% if($d['clinical_syndrome']): %}<span class="muted small">{{{nl_show($lists, 'diagnosis.clinical_syndrome', $d['clinical_syndrome'])}}}</span>{% endif %}
        <span class="status-tag">{{{$d['coding_status']}}}</span>
    </div>
    {% endforeach %}
    {% if(!$dx): %}<p class="muted">{{{t('none recorded')}}}</p>{% endif %}

    <h3>{{{t('Procedures')}}}</h3>
    {% foreach($pr as $p): %}
    <div class="coded-row{% if($p['coding_status'] !== 'confirmed'): %} is-suggested{% endif %}">
        <span class="chip" data-family="procedure">{{{nl_label($lists, 'procedure', $p['procedure_code'])}}}</span>
        {% if($p['is_main']): %}<span class="badge badge-info">{{{t('main')}}}</span>{% endif %}
        {% if($p['levels_list']): %}<span class="chip chip-level">{{{implode(', ', json_decode($p['levels_list'], true))}}}</span>{% endif %}
        {% if($p['location']): %}<span class="chip chip-level">{{{implode(', ', json_decode($p['location'], true))}}}</span>{% endif %}
        <span class="muted">{{{nl_show($lists, 'procedure.side', $p['lesion_side'])}}} · {{{nl_show($lists, 'procedure.approach_type', $p['approach_type'])}}}{% if($p['approach_route']): %} · {{{str_replace('_', ' ', $p['approach_route'])}}}{% endif %}</span>
        <span class="muted small">{{{nl_show($lists, 'procedure.technology', $p['technology'])}}}</span>
        {% if($p['region']): %}<span class="muted small">{{{str_replace('_', ' ', $p['region'])}}}</span>{% endif %}
        {% if($p['branch_pattern']): %}<span class="chip">{{{$p['branch_pattern']}}}</span>{% endif %}
        {% if($p['product']): %}<span class="muted small">{{{$p['product']}}}</span>{% endif %}
        <span class="status-tag">{{{$p['coding_status']}}}</span>
        {% if($p['rf_protocol']): %}
        <div class="rf"><code>{{{$p['rf_protocol']}}}</code> <span class="muted small">{{{str_replace('_', ' ', $p['rf_mode'])}}} · {{{count($cycles[$p['id']] ?? [])}}} {{{t('cycles')}}}</span></div>
        {% endif %}
    </div>
    {% endforeach %}

    <h3>{{{t('Implants')}}}</h3>
    {% foreach($im as $m): %}
    <div class="coded-row{% if($m['coding_status'] !== 'confirmed'): %} is-suggested{% endif %}">
        <span class="chip" data-family="implant">{{{nl_label($lists, 'field.implant.category', $m['implant_category'])}}}</span>
        <strong>×{{{$m['implant_count']}}}</strong>
        <span>{{{$m['company'] ?? t('company not entered')}}}{% if($m['product']): %} · {{{$m['product']}}}{% endif %}</span>
        {% if($m['levels_list']): %}<span class="chip chip-level">{{{implode(', ', json_decode($m['levels_list'], true))}}}</span>{% endif %}
        {% if($m['side']): %}<span class="muted">{{{nl_show($lists, 'procedure.side', $m['side'])}}}</span>{% endif %}
        <span class="small">{{{nl_implant_params_text($m['params'], $m['implant_category'])}}}</span>
        <span class="status-tag">{{{$m['coding_status']}}}</span>
    </div>
    {% endforeach %}
    {% if(!$im): %}<p class="muted">{{{t('none recorded')}}}</p>{% endif %}
    {% if($op['fluoroscopy_time_s'] !== null || $op['adjuncts']): %}<p class="muted small">{% if($op['fluoroscopy_time_s'] !== null): %}{{{t('Fluoroscopy')}}} {{{$op['fluoroscopy_time_s']}}} s{% endif %}{% if($op['adjuncts']): %} · {{{t('Adjuncts')}}}: {{{nl_show($lists, 'field.operation.adjuncts', $op['adjuncts'])}}}{% endif %}</p>{% endif %}

    <h3>{{{t('Suppliers')}}}</h3>
    {% foreach($su as $m): %}
    <div class="coded-row">
        <span class="chip" data-family="supply">{{{nl_label($lists, 'field.supply.kind', $m['supply_kind'])}}}</span>
        <span>{{{$m['company'] ?? ''}}}{% if($m['product']): %} · {{{$m['product']}}}{% endif %}</span>
        {% if($m['note']): %}<span class="muted small">{{{$m['note']}}}</span>{% endif %}
        {% if($m['source'] === 'apyweb'): %}<span class="status-tag">APYweb</span>{% endif %}
    </div>
    {% endforeach %}
    {% if(!$su): %}<p class="muted">{{{t('none recorded')}}}</p>{% endif %}

    {% if($op['quick_line']): %}<h3>{{{t('Quick line')}}}</h3><p class="note">{{ nl_tags_render($op['quick_line']) }}</p>{% endif %}
    {% if($op['op_note']): %}<h3>{{{t('Operative note')}}}</h3><p class="note">{{ nl_tags_render($op['op_note']) }}</p>{% endif %}

    <h3 id="outcomes">{{{t('Complications')}}}</h3>
    {% foreach($out['treats'] as $tr): %}<p class="notice">{{{t('This operation treats complication')}}} <code>{{{nl_id_format($tr['nl_id'])}}}</code> ({{{nl_label($lists, 'complication', $tr['complication_type'])}}}) {{{t('of operation')}}} <a href="{{rel_url('/operations/' . nl_id_format($tr['op_nl']))}}#outcomes"><code>{{{nl_id_format($tr['op_nl'])}}}</code></a>.</p>{% endforeach %}
    {% foreach($out['comps'] as $c): %}
    <div class="coded-row">
        <span class="chip" data-family="complication">{{{nl_label($lists, 'complication', $c['complication_type'])}}}</span>
        <strong>{{{$c['clavien_dindo'] ?? ''}}}</strong>
        <span class="muted">{{{$c['onset_date'] ?? ''}}} · {{{nl_show($lists, 'field.complication.timing', $c['timing'])}}} · {{{nl_show($lists, 'field.complication.treatment', $c['treatment'])}}}{% if($c['outcome_at_90d']): %} · {{{nl_show($lists, 'field.complication.outcome_at_90d', $c['outcome_at_90d'])}}}{% endif %}</span>
        {% if($c['reop_nl']): %}<a href="{{rel_url('/operations/' . nl_id_format($c['reop_nl']))}}">→ {{{t('reoperation')}}} <code>{{{nl_id_format($c['reop_nl'])}}}</code></a>{% endif %}
        {% if($can_edit): %}<a class="small" href="{{rel_url('/complications/' . nl_id_format($c['nl_id']) . '/edit')}}">{{{t('Edit')}}}</a>{% endif %}
    </div>
    {% endforeach %}
    {% if(!$out['comps']): %}<p class="muted">{{{t('none recorded')}}}{% if(!array_filter($out['fus'], fn($f) => $f['no_complications'] === '1' || $f['no_complications'] === 1)): %} · {{{t('"no complication" not yet stated at a follow-up')}}}{% endif %}</p>{% endif %}
    {% if($can_edit): %}<p><a class="btn small-btn" href="{{rel_url('/operations/' . $nl . '/complications/new')}}">+ {{{t('Complication')}}}</a></p>{% endif %}

    <h3>{{{t('Follow-up')}}}</h3>
    <table class="list fu-table">
        <thead><tr><th>{{{t('Window')}}}</th><th>{{{t('Date')}}}</th><th>{{{t('Status')}}}</th><th>{{{t('Scores')}}}</th><th></th></tr></thead>
        <tbody>
        <tr><td>{{{t('baseline')}}}</td><td>{{{$op['op_date']}}}</td><td></td>
            <td class="small">{% if(empty($out['scores']['base'])): %}<span class="muted">{{{t('none')}}}</span>{% else: %}{{{nl_scores_line($out['scores']['base'])}}}{% endif %}</td>
            <td>{% if($can_edit): %}<a class="small" href="{{rel_url('/operations/' . $nl . '/baseline')}}">{{{t('Edit')}}}</a>{% endif %}</td></tr>
        {% foreach($out['fus'] as $f): %}
        <tr><td><strong>{{{$f['fu_window']}}}</strong></td><td>{{{$f['visit_date'] ?? '—'}}}</td><td>{{{$f['status']}}}{% if($f['locked_at']): %} 🔒{% endif %}</td>
            <td class="small">{{{nl_scores_line($out['scores'][$f['id']] ?? [])}}}</td>
            <td>{% if($can_edit && !$f['locked_at']): %}<a class="small" href="{{rel_url('/followups/' . nl_id_format($f['nl_id']) . '/edit')}}">{{{t('Edit')}}}</a>
                <form method="post" action="{{rel_url('/followups/' . nl_id_format($f['nl_id']) . '/lock')}}" class="inline">{{ csrf_field() }}<button class="btn small-btn" type="submit">{{{t('Lock')}}}</button></form>{% endif %}
                {% if($f['locked_at'] && $is_admin): %}<form method="post" action="{{rel_url('/followups/' . nl_id_format($f['nl_id']) . '/lock')}}" class="inline">{{ csrf_field() }}<input type="hidden" name="unlock" value="1"><button class="btn small-btn" type="submit">{{{t('Unlock')}}}</button></form>{% endif %}</td></tr>
        {% endforeach %}
        {% foreach($out['due'] as $w => $d): %}
        <tr class="due-{{{$d['state']}}}"><td>{{{$w}}}</td><td class="muted">{{{$d['from']}}} – {{{$d['to']}}}</td><td><span class="badge {{{$d['state'] === 'overdue' ? 'badge-danger' : ($d['state'] === 'due' ? 'badge-warning' : 'badge-info')}}}">{{{t($d['state'])}}}</span></td><td></td>
            <td>{% if($can_edit): %}<a class="btn small-btn" href="{{rel_url('/operations/' . $nl . '/followups/new')}}?window={{{$w}}}">{{{t('Record')}}}</a>{% endif %}</td></tr>
        {% endforeach %}
        </tbody>
    </table>
    {% if($can_edit): %}<p><a class="btn small-btn" href="{{rel_url('/operations/' . $nl . '/followups/new')}}">+ {{{t('Follow-up')}}}</a> <span class="muted small">{{{t('Windows of this case')}}}: {{{implode(', ', $out['info']['windows'])}}}</span></p>{% endif %}

    {% if($missing): %}
    <div class="notice"><strong>{{{t('Still missing for a complete record')}}}:</strong> {{{implode(', ', $missing)}}}</div>
    {% endif %}

    {% if($can_edit && $pr): %}
    <form method="post" action="{{rel_url('/operations/' . $nl . '/preset')}}" class="preset-save">
        {{ csrf_field() }}
        <label>{{{t('Save these procedure rows as a group preset')}}} <input type="text" name="name" maxlength="80" placeholder="{{{t('e.g. Tubular discectomy')}}}"></label>
        <button class="btn small-btn" type="submit">{{{t('Save as preset')}}}</button>
        <span class="muted small">{{{t('Levels, side and location are not kept.')}}}</span>
    </form>
    {% endif %}

    {% if($history): %}
    <details class="history"><summary>{{{t('Change history')}}} ({{{count($history)}}})</summary>
        <table class="list"><tbody>{% foreach($history as $h): %}<tr><td>{{{$h['cdate']}}}</td><td>{{{$h['cuser']}}}</td><td>{{{$h['field']}}}</td></tr>{% endforeach %}</tbody></table>
    </details>
    {% endif %}
</div>
